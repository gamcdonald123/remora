<div id="<%= container.dom_id %>" class="container-row">
  <span class="state-dot state-<%= container.state_kind %>" title="<%= container.attrs["State"] %>"></span>
  <div class="row-main">
    <div class="row-title">
      <span class="container-name">
        <%= link_to container.display_name, logs_container_path(container.short_id),
              data: { turbo_frame: "drawer" }, class: "logs-link" %>
      </span>
      <% if container.tailscale? %>
        <span class="badge badge-ts" title="<%= container.sidecar ? "behind Tailscale sidecar #{container.sidecar.name}" : "Tailscale" %>">ts</span>
      <% end %>
      <% if Event.flapping?(container.id) %>
        <span class="badge badge-flapping" title="3+ exits within 10 minutes">flapping</span>
      <% elsif (exits = Event.exit_count(container.id)).positive? %>
        <span class="badge badge-exits" title="exits in the last 24h">↻ <%= exits %></span>
      <% end %>
      <span class="container-status"><%= container.status_text %></span>
    </div>
    <div class="row-meta">
      <span class="container-chips">
        <% if container.tailscale? %>
          <% Remora::Tailscale.links_for((container.sidecar || container).id).each do |link| %>
            <%= launch_chip(link) %>
          <% end %>
        <% end %>
        <% container.launch_links.each do |link| %>
          <%= launch_chip(link) %>
        <% end %>
        <% if container.repo_url %>
          <a class="chip chip-repo" href="<%= container.repo_url %>" target="_blank" rel="noreferrer"
             title="<%= container.repo_url %>">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M11.5 3a1.5 1.5 0 1 0-2 1.415v.335a1.25 1.25 0 0 1-1.25 1.25h-2.5c-.45 0-.875.12-1.25.325V4.415a1.5 1.5 0 1 0-1 0v7.17a1.5 1.5 0 1 0 1 0V8.75c0-.69.56-1.25 1.25-1.25h2.5A2.25 2.25 0 0 0 10.5 5.25v-.835c.583-.206 1-.762 1-1.415Z"/></svg>
            src
          </a>
        <% end %>
      </span>
      <span class="container-image"><%= container.image %></span>
      <%= uptime_strip(container.id) %>
    </div>
  </div>
  <span class="container-actions">
    <% if container.state_kind == :exited %>
      <%= button_to "start", start_container_path(container.short_id), class: "action-button" %>
    <% else %>
      <%= button_to "restart", restart_container_path(container.short_id), class: "action-button" %>
      <%= button_to "stop", stop_container_path(container.short_id), class: "action-button action-stop",
            form: { data: { controller: "confirm", action: "submit->confirm#intercept" } } %>
    <% end %>
  </span>
</div>
